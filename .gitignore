*.pyc

# Storage (runtime data — never commit real bundles)
storage/raw_ingestion/*
!storage/raw_ingestion/.gitkeep
storage/.staging/*
!storage/.staging/.gitkeep
storage/dispatch_log/*
!storage/dispatch_log/.gitkeep

# Local env & editor
.env
.env.local
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Claude scratch
.claude/
